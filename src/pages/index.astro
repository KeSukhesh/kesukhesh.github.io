---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Seal from '../components/Seal.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const blogPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const links = [
  { href: 'https://github.com/kesukhesh', label: 'GitHub' },
  { href: 'https://linkedin.com/in/sukheshkp', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/sukhesh_kp/', label: 'Instagram' },
];
---

<BaseLayout title="Sukhesh Patro" description="Personal website of Sukhesh Patro." fullHeight>
  <div data-ink-scene>
    <!-- Hero: the tree on the hill, name inscribed in the empty sky -->
    <section class="relative h-[100svh] min-h-[520px]">
      <canvas data-ink-hero class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
      <div class="absolute z-10 top-[calc(4rem+6vh)] left-[max(1.5rem,6vw)] max-w-[min(46%,36rem)] max-sm:max-w-[calc(100%-3rem)] flex flex-col items-start gap-3">
        <h1 class="text-[clamp(3rem,7vw,6rem)] leading-[.92] tracking-[.01em]">Sukhesh<br />Patro</h1>
        <p class="italic text-ink-2 text-lg md:text-xl">I like to think.</p>
        <div class="caps flex gap-5 text-sm">
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="border-b border-muted pb-0.5 hover:text-forest hover:border-forest transition-colors">{l.label}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- The ridge brushes itself down past About -->
    <section id="about" data-ink-flow class="relative px-6 pt-[clamp(140px,24vw,300px)] pb-[clamp(90px,14vw,180px)] scroll-mt-16">
      <canvas class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
      <div class="relative z-10 max-w-6xl mx-auto">
        <div class="ml-auto w-full sm:w-[56%] max-w-[34rem] max-sm:bg-paper/80 max-sm:py-3">
          <h2 class="text-[clamp(2.2rem,4vw,3rem)] leading-tight mb-4">About</h2>
          <div class="space-y-4 text-lg leading-relaxed text-ink-2">
            <p>
              I started as an engineer. Now I build businesses the same way I build software: as systems. I lead Engineering, People, and Sales at <a href="https://www.lyratechnologies.com.au/" target="_blank" rel="noopener noreferrer" class="text-ink border-b border-ink/30 hover:text-forest hover:border-forest transition-colors">Lyra</a>, where we've scaled from 25 to 85+ engineers.
            </p>
            <p>
              Philosophy and economics shape how I think about most things. Personal growth fills in the rest. I read a lot, write when something sticks, and try to get better at all of it every day.
            </p>
          </div>
          <p class="caps text-xs text-muted mt-6">Lyra · UNSW · Engineering · Philosophy · Economics · Personal Growth · Systems</p>
        </div>
      </div>
    </section>

    <!-- The ridge ends at a scroll that unrolls with the latest writing -->
    <section id="blog" data-parchment class="parchment relative max-w-[620px] mx-auto px-[18px] mb-24 scroll-mt-20">
      <div class="roller"></div>
      <div data-sheet class="sheet px-[clamp(20px,5vw,44px)] pt-9 pb-9">
        <h2 class="text-[clamp(2.2rem,4vw,3rem)] leading-tight mb-3">Writing</h2>
        {blogPosts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block py-4 border-t border-border">
            <time class="caps text-xs text-muted" datetime={post.data.date.toISOString().split('T')[0]}>
              {post.data.date.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <strong class="block font-semibold text-lg mt-1.5 mb-1 group-hover:text-forest transition-colors">{post.data.title}</strong>
            <span class="italic text-ink-2">{post.data.description}</span>
          </a>
        ))}
        <div class="flex items-center justify-between gap-3 mt-4 pt-4 border-t border-border">
          <a href="/blog" class="caps text-sm text-forest hover:text-forest-light transition-colors">Read the whole library →</a>
          <Seal />
        </div>
      </div>
      <div class="roller bottom"></div>
    </section>
  </div>
</BaseLayout>

<style>
  .parchment { --p: 1; --sheet-h: 0px; }
  .roller {
    position: relative;
    z-index: 2;
    height: 18px;
    margin-inline: -14px;
    border-radius: 9px;
    background: linear-gradient(var(--wood-hi), var(--wood) 70%);
  }
  .roller::before, .roller::after {
    content: "";
    position: absolute;
    top: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--wood);
    box-shadow: inset 0 0 0 3px var(--wood-hi);
  }
  .roller::before { left: -8px; }
  .roller::after { right: -8px; }
  .roller.bottom { transform: translateY(calc((var(--p) - 1) * var(--sheet-h))); }
  .sheet {
    background: var(--parch);
    clip-path: inset(0 0 calc((1 - var(--p)) * 100%) 0);
    box-shadow: inset 0 10px 14px -12px rgb(0 0 0 / .35), inset 0 -10px 14px -12px rgb(0 0 0 / .35);
  }
</style>

<script>
  import { startInkScene } from '../scripts/ink-scene.js';
  const el = document.querySelector<HTMLElement>('[data-ink-scene]');
  if (el) startInkScene(el);
</script>
