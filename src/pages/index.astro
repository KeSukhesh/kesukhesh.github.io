---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: 'https://github.com/kesukhesh', label: 'github' },
  { href: 'https://linkedin.com/in/sukheshkp', label: 'linkedin' },
  { href: 'https://www.instagram.com/sukhesh.kp/', label: 'instagram' },
];
---

<BaseLayout title="Sukhesh Patro" description="Personal website of Sukhesh Patro." fullHeight footer={false}>
  <!-- The sky is the whole page: nothing to scroll to. -->
  <canvas
    data-skies
    class="fixed left-0 top-0 block touch-none"
    role="img"
    aria-label="Animated ASCII sky: Appa and Momo drift low over the clouds, Aang swoops past throwing blue air, and Toothless lurks at the edges before dive-bombing, sometimes spiralling across with the Light Fury and their three Night Lights. Moving the pointer stirs the wind."
  ></canvas>

  <section class="intro relative z-10 min-h-[100svh] flex items-end px-[max(1.5rem,20vw)] pb-[max(3rem,11vh)] pointer-events-none">
    <div class="font-geist text-[15px] leading-[27px] max-w-[56rem] pointer-events-auto">
      <p class="tagline mb-[54px]">let go of the ground,<br />learn the wind<span class="cursor" aria-hidden="true"></span></p>
      <div class="flex flex-col gap-[11px]">
        <p>Hi, I'm Sukhesh.</p>
        <p>I started as an engineer. Now I build businesses the way I build software: as systems.</p>
        <p>Leading Engineering, People and Sales @ <a href="https://www.lyratechnologies.com.au/" target="_blank" rel="noopener noreferrer">Lyra</a>, where we've scaled from 25 to 85+ engineers.</p>
      </div>
      <p class="mt-[30px]">
        {links.map((l, i) => (
          <>{i > 0 && <span class="sep"> / </span>}<a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></>
        ))}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Text sits straight on the sky, haloed in the sky's own colour so passing fliers don't swallow it. */
  .intro { --text: #f2efe8; --dim: rgb(242 239 232 / .6); --halo: #151517; color: var(--text); }
  :global(html:not(.dark)) .intro { --text: #1d1d20; --dim: rgb(29 29 32 / .58); --halo: #efeff0; }
  .intro p { text-shadow: 0 0 4px var(--halo), 0 0 12px var(--halo); }
  .tagline, .sep { color: var(--dim); }
  .intro a {
    text-decoration: underline;
    text-decoration-color: var(--dim);
    text-underline-offset: 5px;
    transition: text-decoration-color .2s;
  }
  .intro a:hover { text-decoration-color: currentColor; }
  .intro a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .cursor {
    display: inline-block;
    width: .6em;
    height: 1.05em;
    margin-left: 4px;
    vertical-align: -.18em;
    background: currentColor;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  :global(html) { overflow: hidden; }
</style>

<script>
  import { startSkies } from '../scripts/skies-scene.js';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-skies]');
  if (canvas) startSkies(canvas);
</script>
