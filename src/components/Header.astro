---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isHome = path === '/';

const navLinks = [
  { href: '/', label: 'sky', active: isHome },
  { href: '/blog', label: 'blog', active: path.startsWith('/blog') },
];
---

<!-- On the home page the nav floats over the sky; elsewhere it gets a bar so it reads over the page. -->
<header class:list={[
  'fixed top-0 left-0 right-0 z-50 transition-colors duration-300',
  !isHome && 'bg-paper/80 backdrop-blur-sm border-b border-border/60',
]}>
  <nav class="h-16 flex items-center justify-center gap-8 font-geist text-[13px]">
    {navLinks.map(link => (
      <a
        href={link.href}
        aria-current={link.active ? 'page' : undefined}
        class:list={['transition-colors duration-200', link.active ? 'text-ink' : 'text-muted hover:text-ink']}
      >
        {link.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>
