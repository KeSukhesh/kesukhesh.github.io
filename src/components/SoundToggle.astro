<button
  data-sound-toggle
  type="button"
  aria-pressed="false"
  aria-label="Play background music"
  class="p-2 rounded-sm text-ink-2 hover:text-ink transition-colors duration-200"
>
  <!-- Note with sound waves; the waves show only while playing -->
  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 18V6l8-2v12" />
    <circle cx="7" cy="18" r="2" />
    <circle cx="15" cy="16" r="2" />
    <path data-sound-waves class="hidden" d="M20 9.5a4 4 0 0 1 0 5M21.8 7.5a7 7 0 0 1 0 9" />
  </svg>
</button>

<script>
  // One shared track for every toggle on the page. Off by default; the choice and the
  // playback position carry across pages so the song continues instead of restarting.
  const SRC = '/audio/leaves-from-the-vine.mp3';
  const VOLUME = 0.35;
  const store = {
    get: (k: string, s = localStorage) => { try { return s.getItem(k); } catch { return null; } },
    set: (k: string, v: string, s = localStorage) => { try { s.setItem(k, v); } catch {} },
  };

  const audio = new Audio();
  audio.loop = true;
  audio.preload = 'none';
  audio.volume = 0;
  let fade = 0;
  let playing = false;

  function render(on: boolean) {
    document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
      b.setAttribute('aria-pressed', String(on));
      b.setAttribute('aria-label', on ? 'Pause background music' : 'Play background music');
      b.querySelector('[data-sound-waves]')?.classList.toggle('hidden', !on);
    });
  }

  function rampTo(target: number, done?: () => void) {
    cancelAnimationFrame(fade);
    const from = audio.volume, start = performance.now(), ms = 1200;
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / ms);
      audio.volume = from + (target - from) * t;
      if (t < 1) fade = requestAnimationFrame(tick); else done?.();
    };
    fade = requestAnimationFrame(tick);
  }

  async function play() {
    if (!audio.src) {
      audio.src = SRC;
      audio.currentTime = Number(store.get('sound-time', sessionStorage)) || 0;
    }
    try {
      await audio.play();
    } catch {
      // Browser blocked playback (no user gesture yet); stay off.
      render(false);
      return false;
    }
    playing = true;
    render(true);
    rampTo(VOLUME);
    return true;
  }

  function pause() {
    playing = false;
    render(false);
    rampTo(0, () => audio.pause());
  }

  document.querySelectorAll('[data-sound-toggle]').forEach((b) =>
    b.addEventListener('click', async () => {
      const on = !playing;
      store.set('sound', on ? 'on' : 'off');
      if (on) await play(); else pause();
    }),
  );

  addEventListener('pagehide', () => store.set('sound-time', String(audio.currentTime), sessionStorage));

  // If they had it on, resume on their first interaction (browsers block audio before one).
  if (store.get('sound') === 'on') {
    const resume = () => { play(); removeEventListener('pointerdown', resume); removeEventListener('keydown', resume); };
    addEventListener('pointerdown', resume, { once: true });
    addEventListener('keydown', resume, { once: true });
  }
</script>
